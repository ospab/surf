/* surf - Высококонтрастная светлая тема со скруглённым интерфейсом */

QMainWindow, QDialog {
    background-color: #f2f2f7;
    color: #15141a;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #15141a;
}

/* Верхняя полоса вкладок */
#tabBarContainer {
    background-color: #e5e5ea;
    padding-top: 4px;
    padding-left: 4px;
    padding-right: 4px;
    border-bottom: 1px solid #d1d1d6;
}

QTabBar {
    background-color: transparent;
    border: none;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #dedee4;
    color: #2c2c34;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 12px;
    padding-right: 28px;
    margin-right: 3px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 75px;
    max-width: 210px;
    height: 22px;
    border: 1px solid #d1d1d6;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #000000;
    font-weight: 700;
    border-top: 1.5px solid #c7c7cc;
    border-left: 1.5px solid #c7c7cc;
    border-right: 1.5px solid #c7c7cc;
    border-bottom: 2.5px solid __ACCENT__;
}

QTabBar::tab:hover:!selected {
    background-color: #eaeaf0;
    color: #000000;
}

/* Кнопка закрытия вкладки (высококонтрастный крестик с аккуратным hover-эффектом) */
#tabCloseBtn, QTabBar::close-button {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}

#tabCloseBtn:hover, QTabBar::close-button:hover {
    background-color: rgba(0, 0, 0, 0.12);
}

#tabCloseBtn:pressed, QTabBar::close-button:pressed {
    background-color: rgba(0, 0, 0, 0.22);
}

/* Кнопки прокрутки вкладок */
QTabBar QToolButton {
    background-color: #dedee4;
    border: 1px solid #c7c7cc;
    border-radius: 4px;
    padding: 2px;
    margin: 2px;
    min-width: 16px;
    max-width: 16px;
}

QTabBar QToolButton:hover {
    background-color: #ffffff;
    border-color: __ACCENT__;
}

/* Кнопка "+" добавления вкладки */
#newTabBtn {
    background-color: #dedee4;
    border: 1px solid #c7c7cc;
    border-radius: 6px;
    padding: 3px;
    min-width: 26px;
    max-width: 26px;
    min-height: 24px;
    max-height: 24px;
}

#newTabBtn:hover {
    background-color: #ffffff;
    border-color: __ACCENT__;
}

#newTabBtn:pressed {
    background-color: #d1d1d6;
}

/* Панель навигации */
#navToolbar {
    background-color: #ffffff;
    border-bottom: 1px solid #d1d1d6;
    padding: 4px 8px;
    min-height: 38px;
    max-height: 38px;
}

#navToolbar QToolButton {
    background-color: transparent;
    color: #15141a;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}

#navToolbar QToolButton:hover {
    background-color: #e5e5ea;
}

#navToolbar QToolButton:pressed {
    background-color: #d1d1d6;
}

/* Адресная строка */
QLineEdit#addressBar {
    background-color: #f2f2f7;
    color: #15141a;
    border: 1.5px solid #c7c7cc;
    border-radius: 14px;
    padding: 5px 14px;
    font-size: 13px;
    selection-background-color: __ACCENT__;
    selection-color: #ffffff;
}

QLineEdit#addressBar:focus {
    border: 2px solid __ACCENT__;
    background-color: #ffffff;
}

/* Меню */
QMenuBar {
    background-color: #e5e5ea;
    color: #15141a;
    border-bottom: 1px solid #d1d1d6;
    padding: 2px 6px;
}

QMenuBar::item {
    padding: 4px 8px;
    border-radius: 5px;
    color: #15141a;
}

QMenuBar::item:selected {
    background-color: #d1d1d6;
    color: #000000;
}

QMenu {
    background-color: #ffffff;
    color: #15141a;
    border: 1px solid #c7c7cc;
    border-radius: 8px;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 24px;
    color: #15141a;
}

QMenu::item:selected {
    background-color: __ACCENT__;
    color: #ffffff;
    border-radius: 4px;
}

QMenu::separator {
    height: 1px;
    background-color: #e5e5ea;
    margin: 4px 8px;
}

/* Строка состояния */
QStatusBar {
    background-color: #e5e5ea;
    color: #15141a;
    border-top: 1px solid #d1d1d6;
}

QStatusBar QLabel {
    color: #15141a;
}

#zoomBtn {
    background-color: #dedee4;
    color: #15141a;
    border: 1px solid #c7c7cc;
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: 600;
}

#zoomBtn:hover {
    background-color: #ffffff;
    color: #000000;
    border-color: __ACCENT__;
}

/* Панель поиска */
#findBar {
    background-color: #ffffff;
    border-top: 1px solid #d1d1d6;
    padding: 4px 12px;
}

#findBar QLabel {
    color: #15141a;
    font-weight: 600;
}

#findBar QLineEdit {
    background-color: #f2f2f7;
    color: #15141a;
    border: 1.5px solid #c7c7cc;
    border-radius: 4px;
    padding: 4px 8px;
}

#findBar QLineEdit:focus {
    border: 1.5px solid __ACCENT__;
    background-color: #ffffff;
}

#findBar QPushButton {
    background-color: #f2f2f7;
    color: #15141a;
    border: 1px solid #c7c7cc;
    border-radius: 4px;
    padding: 4px 10px;
    font-weight: 500;
}

#findBar QPushButton:hover {
    background-color: #ffffff;
    border-color: __ACCENT__;
}

/* Стартовая страница */
#speedDialWidget {
    background-color: #f2f2f7;
}

#speedDialLogo {
    font-size: 52px;
    font-weight: 800;
    color: #15141a;
    letter-spacing: 2px;
}

#speedDialSubtitle {
    font-size: 14px;
    color: #48484a;
    margin-bottom: 12px;
}

#speedDialSearch {
    background-color: #ffffff;
    border: 1.5px solid #c7c7cc;
    border-radius: 22px;
    font-size: 14px;
    padding: 10px 20px;
    color: #15141a;
    selection-background-color: __ACCENT__;
    selection-color: #ffffff;
}

#speedDialSearch:focus {
    border: 2px solid __ACCENT__;
    background-color: #ffffff;
}

/* Режим чтения */
#readerToolbar {
    background-color: #e5e5ea;
    border-bottom: 1px solid #d1d1d6;
}

#readerTitleLabel {
    font-weight: bold;
    color: #15141a;
}

#readerBrowser {
    background-color: #ffffff;
    border: none;
}

#readerExitBtn {
    background-color: __ACCENT__;
    color: #ffffff;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 5px 14px;
}

/* Таблицы */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8f8fb;
    color: #15141a;
    border: 1px solid #c7c7cc;
    border-radius: 8px;
    gridline-color: #e5e5ea;
    selection-background-color: __ACCENT__;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #e5e5ea;
    color: #15141a;
    padding: 6px;
    border: 1px solid #d1d1d6;
    font-weight: bold;
}

/* Прогресс-бар */
QProgressBar {
    border: none;
    background-color: transparent;
    height: 2px;
}

QProgressBar::chunk {
    background-color: __ACCENT__;
}

/* Диалог настроек и формы */
QGroupBox {
    border: 1.5px solid #c7c7cc;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: bold;
    color: #15141a;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: __ACCENT__;
    font-weight: bold;
}

QLabel {
    color: #15141a;
}

QComboBox, QSpinBox {
    background-color: #ffffff;
    color: #15141a;
    border: 1.5px solid #c7c7cc;
    border-radius: 6px;
    padding: 5px 10px;
}

QComboBox:focus, QSpinBox:focus {
    border: 1.5px solid __ACCENT__;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #15141a;
    selection-background-color: __ACCENT__;
    selection-color: #ffffff;
    border: 1px solid #c7c7cc;
}

QLineEdit {
    background-color: #ffffff;
    color: #15141a;
    border: 1.5px solid #c7c7cc;
    border-radius: 6px;
    padding: 5px 10px;
}

QLineEdit:focus {
    border: 1.5px solid __ACCENT__;
}

QPushButton {
    background-color: #ffffff;
    color: #15141a;
    border: 1px solid #c7c7cc;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #e5e5ea;
    border-color: __ACCENT__;
}

QPushButton:pressed {
    background-color: #d1d1d6;
}

QCheckBox {
    color: #15141a;
    spacing: 8px;
}

QTabWidget::pane {
    border: 1px solid #c7c7cc;
    border-radius: 6px;
    background-color: #ffffff;
}

QTabWidget QTabBar::tab {
    background-color: #dedee4;
    color: #2c2c34;
    border: 1px solid #d1d1d6;
    border-bottom: none;
    padding: 6px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabWidget QTabBar::tab:selected {
    background-color: #ffffff;
    color: #15141a;
    font-weight: bold;
    border-bottom: 2px solid __ACCENT__;
}
