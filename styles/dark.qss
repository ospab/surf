/* surf - Тёмная тема со скруглённым интерфейсом и динамическим акцентом */

QMainWindow, QDialog {
    background-color: #1a1a20;
    color: #fbfbfe;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #fbfbfe;
}

/* Верхняя полоса вкладок */
#tabBarContainer {
    background-color: #1c1b22;
    padding-top: 5px;
    padding-bottom: 3px;
    padding-left: 6px;
    padding-right: 6px;
    border-bottom: 1px solid #2b2a33;
}

QTabBar {
    background-color: transparent;
    border: none;
    qproperty-drawBase: 0;
}

/* Парящие вкладки surf */
QTabBar::tab {
    background-color: transparent;
    color: #a4a4b2;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    margin-top: 2px;
    margin-bottom: 2px;
    margin-right: 3px;
    margin-left: 0px;
    border-radius: 8px;
    min-width: 80px;
    max-width: 220px;
    height: 22px;
    border: 1px solid transparent;
}

QTabBar::tab:selected {
    background-color: #42414d;
    color: #ffffff;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 2.5px solid __ACCENT__;
}

QTabBar::tab:hover:!selected {
    background-color: rgba(255, 255, 255, 0.08);
    color: #fbfbfe;
}

/* Кнопки закрытия и звука вкладки */
#tabCloseBtn, #tabAudioBtn, QTabBar::close-button {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}

#tabCloseBtn:hover, #tabAudioBtn:hover, QTabBar::close-button:hover {
    background-color: rgba(255, 255, 255, 0.22);
}

#tabCloseBtn:pressed, #tabAudioBtn:pressed, QTabBar::close-button:pressed {
    background-color: rgba(255, 255, 255, 0.35);
}

/* Кнопки прокрутки вкладок (при >50-200 вкладках) */
QTabBar QToolButton {
    background-color: #24242d;
    border: 1px solid #353542;
    border-radius: 4px;
    padding: 2px;
    margin: 2px;
    min-width: 16px;
    max-width: 16px;
}

QTabBar QToolButton:hover {
    background-color: #353542;
    border-color: __ACCENT__;
}

/* Кнопка "+" добавления вкладки */
#newTabBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px;
    min-width: 26px;
    max-width: 26px;
    min-height: 24px;
    max-height: 24px;
}

#newTabBtn:hover {
    background-color: #2c2c38;
    border-color: __ACCENT__;
}

/* Панель навигации под вкладками */
#navToolbar {
    background-color: #24242d;
    border-bottom: 1px solid #282832;
    padding: 3px 8px;
    min-height: 38px;
    max-height: 38px;
}

/* Кнопки навигации тулбара (только прямые потомки) */
#navToolbar > QToolButton {
    background-color: transparent;
    color: #fbfbfe;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}

#navToolbar > QToolButton:hover {
    background-color: #353542;
}

#navToolbar > QToolButton:pressed {
    background-color: #424254;
}

/* Скруглённая адресная строка */
QLineEdit#addressBar {
    background-color: #1a1a20;
    color: #fbfbfe;
    border: 1px solid #353542;
    border-radius: 14px;
    padding: 0px 6px;
    min-height: 28px;
    font-size: 13px;
    selection-background-color: __ACCENT__;
}

QLineEdit#addressBar:focus {
    border: 1.5px solid __ACCENT__;
    background-color: #202028;
}

/* Значки действий внутри адресной строки (SSL, Shield, Reader, Bookmark) */
QLineEdit QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    margin: 0px 1px;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
}

QLineEdit QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

QLineEdit QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.25);
}

/* Меню */
QMenuBar {
    background-color: #1a1a20;
    color: #cfcfd8;
    border-bottom: 1px solid #282832;
    padding: 2px 6px;
}

QMenuBar::item {
    padding: 4px 8px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #2c2c38;
    color: #ffffff;
}

QMenu {
    background-color: #24242d;
    color: #fbfbfe;
    border: 1px solid #353542;
    border-radius: 8px;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 22px;
}

QMenu::item:selected {
    background-color: __ACCENT__;
    color: #ffffff;
    border-radius: 4px;
}

QMenu::separator {
    height: 1px;
    background-color: #353542;
    margin: 4px 6px;
}

/* Таблицы */
QTableWidget {
    background-color: #24242d;
    alternate-background-color: #1e1e26;
    color: #fbfbfe;
    border: 1px solid #353542;
    border-radius: 8px;
    gridline-color: #2c2c38;
    selection-background-color: __ACCENT__;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #1a1a20;
    color: #cfcfd8;
    padding: 6px;
    border: 1px solid #282832;
    font-weight: bold;
}

/* Прогресс-бар загрузки */
QProgressBar {
    border: none;
    background-color: transparent;
    height: 2px;
}

QProgressBar::chunk {
    background-color: __ACCENT__;
}

/* Строка состояния */
QStatusBar {
    background-color: #1a1a20;
    color: #8f8f9d;
    border-top: 1px solid #282832;
    padding: 2px 10px;
}

#zoomBtn {
    background-color: transparent;
    color: #a4a4b2;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: 600;
}

#zoomBtn:hover {
    background-color: #2c2c38;
    color: #fbfbfe;
    border-color: __ACCENT__;
}

/* Панель поиска */
#findBar {
    background-color: #24242d;
    border-top: 1px solid #353542;
    padding: 4px 12px;
}

/* Стартовая страница */
#speedDialWidget {
    background-color: #1c1b22;
}

#speedDialLogo {
    font-size: 52px;
    font-weight: 800;
    color: #fbfbfe;
    letter-spacing: 2px;
}

#speedDialSubtitle {
    font-size: 14px;
    color: #9d9da8;
    margin-bottom: 12px;
}

#speedDialSearch {
    background-color: #24242d;
    border: 1px solid #353542;
    border-radius: 22px;
    font-size: 14px;
    padding: 10px 20px;
    color: #fbfbfe;
    selection-background-color: __ACCENT__;
}

#speedDialSearch:focus {
    border: 1.5px solid __ACCENT__;
    background-color: #2a2a35;
}

/* Сетка плиток быстрого доступа (Speed Dial / Top Sites) */
#speedDialContainer {
    background: transparent;
}

SpeedDialCard, #speedDialCard, .SpeedDialCard {
    background-color: #24242d;
    border: 1px solid #353542;
    border-radius: 12px;
}

SpeedDialCard:hover, #speedDialCard:hover, .SpeedDialCard:hover {
    background-color: #2e2e3a;
    border-color: #48485a;
}

#speedDialCardTitle {
    color: #fbfbfe;
    font-size: 12px;
    font-weight: 500;
}

#speedDialAddCard {
    background-color: rgba(36, 36, 45, 0.6);
    border: 1.5px dashed #3e3e4f;
    border-radius: 12px;
}

#speedDialAddCard:hover {
    background-color: #24242d;
    border: 1.5px dashed __ACCENT__;
}

#speedDialAddTitle {
    color: #9d9da8;
    font-size: 12px;
    font-weight: 500;
}

#speedDialAddCard:hover #speedDialAddTitle {
    color: #fbfbfe;
}

#tileMenuBtn {
    background: transparent;
    border: none;
    border-radius: 9px;
    color: #8f8f9d;
    font-size: 13px;
    font-weight: bold;
    padding: 0;
    line-height: 1;
}

#tileMenuBtn:hover {
    background-color: #353542;
    color: #fbfbfe;
}

/* Диалог добавления/редактирования ярлыка */
#speedDialDialog {
    background-color: #1c1b22;
}

#speedDialDialog QLabel {
    color: #fbfbfe;
    font-size: 13px;
    font-weight: 500;
}

#speedDialDialog QLineEdit {
    background-color: #24242d;
    border: 1px solid #353542;
    border-radius: 6px;
    padding: 6px 12px;
    color: #fbfbfe;
    font-size: 13px;
}

#speedDialDialog QLineEdit:focus {
    border-color: __ACCENT__;
}

#speedDialDialog #btnPrimary {
    background-color: __ACCENT__;
    color: #ffffff;
    border: 1px solid __ACCENT__;
    border-radius: 6px;
    font-weight: bold;
    padding: 6px 16px;
}

#speedDialDialog #btnPrimary:hover {
    background-color: __ACCENT__;
    opacity: 0.9;
}

/* Диалог настроек и модальные окна */
QGroupBox {
    border: 1px solid #353542;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: __ACCENT__;
}

/* Вкладки в диалогах (QTabWidget) */
QTabWidget::pane {
    border: 1px solid #353542;
    border-radius: 6px;
    background-color: #24242d;
}

QTabWidget QTabBar::tab {
    background-color: #1a1a20;
    color: #a4a4b2;
    border: 1px solid #353542;
    border-bottom: none;
    padding: 6px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabWidget QTabBar::tab:selected {
    background-color: #24242d;
    color: #ffffff;
    font-weight: bold;
    border-bottom: 2px solid __ACCENT__;
}

QTabWidget QTabBar::tab:hover:!selected {
    background-color: #2c2c38;
    color: #fbfbfe;
}

QTextEdit {
    background-color: #1a1a20;
    color: #fbfbfe;
    border: 1px solid #353542;
    border-radius: 6px;
    padding: 6px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 11px;
}

QComboBox, QSpinBox, QDateEdit {
    background-color: #1a1a20;
    color: #fbfbfe;
    border: 1px solid #353542;
    border-radius: 6px;
    padding: 4px 10px;
}

QComboBox:focus, QSpinBox:focus, QDateEdit:focus {
    border-color: __ACCENT__;
}

QPushButton {
    background-color: #2c2c38;
    border: 1px solid #353542;
    border-radius: 6px;
    padding: 5px 12px;
}

QPushButton:hover {
    background-color: #353542;
    border-color: __ACCENT__;
}

QPushButton:pressed {
    background-color: #424254;
}

#readerExitBtn {
    background-color: __ACCENT__;
    color: #ffffff;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 5px 14px;
}

#readerExitBtn:hover {
    opacity: 0.9;
}

QListWidget {
    background-color: #24242d;
    color: #fbfbfe;
    border: 1px solid #353542;
    border-radius: 8px;
    selection-background-color: __ACCENT__;
    selection-color: #ffffff;
}

QListWidget::item {
    padding: 4px 8px;
}

QCalendarWidget QWidget {
    background-color: #1a1a20;
    color: #fbfbfe;
    alternate-background-color: #24242d;
}

QCalendarWidget QToolButton {
    color: #fbfbfe;
    background-color: transparent;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #1a1a20;
    color: #fbfbfe;
    selection-background-color: __ACCENT__;
    selection-color: #ffffff;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #6b6b78;
}

QRadioButton {
    color: #fbfbfe;
    spacing: 6px;
}
